# ── SL Tech Radar · backend env ──────────────────────────────────────
# Copy to .env and fill in. EVERYTHING is optional: with no keys set the
# app boots in mock mode (curated sample candidates, template drafts).

# --- Server ---
# PORT=8080

# --- Database (default profile = Postgres via docker-compose) ---
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=sltechradar
# DB_USER=radar
# DB_PASSWORD=radar-dev          # docker-compose default; override in prod

# --- Provider fallback chain (comma order = priority) ---
# APP_PROVIDERS_ORDER=nebius,groq,gemini,ollama,template
NEBIUS_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434   # local Ollama, free forever

# --- Search ---
TAVILY_API_KEY=              # 1,000 free searches/month
# TAVILY_MAX_RESULTS=10
# TAVILY_TIME_RANGE=week
# TAVILY_SEARCH_DEPTH=basic

# --- Observability (LangSmith tracing activates only when set) ---
LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=sl-tech-radar

# --- Mock mode ---
# APP_MOCK_ENABLED=true        # false = fail loudly instead of mocking
